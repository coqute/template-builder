{
  "name": "template-builder",
  "version": "0.14.2",
  "private": true,
  "description": "Template Builder — 주간보고·반복 이메일·작업일지를 정해진 형식으로 쓰고 검증하는 데스크톱 앱",
  "author": "hojhk",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build",
    "build:electron": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && vite build && electron-builder",
    "release:win": "powershell -ExecutionPolicy Bypass -File scripts/release-install.ps1",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "verify:weekly": "node scripts/verify-weekly.mjs",
    "guard": "node scripts/public-guard.mjs --tree . --lines",
    "guard:history": "node scripts/public-guard.mjs --history",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "lint": "tsc --noEmit -p tsconfig.json",
    "build:icon": "node scripts/build-icon.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.10.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "@lezer/highlight": "^1.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "allotment": "^1.20.2",
    "autoprefixer": "^10.4.20",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.460.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "sonner": "^1.7.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.templatebuilder.app",
    "productName": "TemplateBuilder",
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "dist-electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "assets/sample-week.md"
    ],
    "extraResources": [
      {
        "from": "assets/sample-week.md",
        "to": "assets/sample-week.md"
      },
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      },
      {
        "from": "assets/icon.ico",
        "to": "assets/icon.ico"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Template Builder",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png"
    },
    "linux": {
      "icon": "assets/icon.png"
    }
  }
}
