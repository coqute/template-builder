{
  "id": "tech-inquiry",
  "name": "제조사 기술 문의",
  "recipientHint": "support@vendor.example",
  "recipientCc": ["sales@vendor.example", "biz@vendor.example", "team@company.example"],
  "subjectPattern": "{topic}",
  "note": "제조사 지원팀에 고객 기술 문의를 전달하는 표준 양식. 표는 폼으로, 요청내용은 본문에 이미지 포함 자유 작성.",
  "sections": [
    {
      "title": "",
      "fields": [
        {
          "key": "topic",
          "label": "메일 제목",
          "type": "text",
          "placeholder": "예: [예시IT] 사용자 지정 분류 필드값 문의 (ABZ+)",
          "required": true,
          "subjectOnly": true,
          "wide": true
        }
      ]
    },
    {
      "title": "",
      "fields": [
        {
          "key": "issue",
          "label": "이슈",
          "type": "text",
          "required": true,
          "bodyLead": true,
          "wide": true,
          "placeholder": "예: 보고서 CSV 내려받기 실패 안내 문구 노출 및 기능 사용 불가"
        }
      ]
    },
    {
      "title": "기본 정보",
      "fields": [
        { "key": "requestDate", "label": "요청일자", "type": "date", "default": "today", "required": true },
        { "key": "customer", "label": "고객사명", "type": "text", "placeholder": "ABZ+", "required": true },
        { "key": "project", "label": "프로젝트명", "type": "text", "placeholder": "관제개발팀" },
        { "key": "serverOs", "label": "수집서버 OS 및 버전", "type": "text", "placeholder": "RHEL 8.10", "wide": true },
        { "key": "serverSpec", "label": "수집서버 스펙", "type": "text", "default": "-" },
        {
          "key": "product",
          "label": "문의 제품",
          "type": "select",
          "options": ["Job Manager", "서버모니터링", "APM", "NMS 콘솔", "웹 점검", "데이터베이스", "쿠버네티스", "로그 모니터링"],
          "required": true
        }
      ]
    },
    {
      "title": "제조사 정보",
      "fields": [
        { "key": "contractType", "label": "계약 유형", "type": "select", "options": ["POC", "유상", "무상"] },
        { "key": "serviceType", "label": "서비스 유형", "type": "select", "options": ["설치형", "SaaS", "설치형, SaaS"] },
        { "key": "serverVersion", "label": "수집서버 버전", "type": "text", "placeholder": "collector-x.y.z", "wide": true },
        { "key": "agentVersion", "label": "에이전트 버전", "type": "text", "placeholder": "job-manager-x.y.z", "wide": true },
        { "key": "logFile", "label": "로그파일", "type": "text", "default": "-" }
      ]
    }
  ],
  "hasBody": true,
  "bodyLabel": "요청내용",
  "bodyPlaceholder": "문의 배경과 구체적 질문을 작성하세요. 화면 캡처 이미지·글머리 기호 사용 가능."
}
