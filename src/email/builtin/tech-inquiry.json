{
  "id": "tech-inquiry",
  "name": "제조사 기술 문의",
  "recipientHint": "support@vendor.example",
  "recipientCc": ["sales@vendor.example", "biz@vendor.example", "team@company.example"],
  "subjectPattern": "{topic}",
  "note": "제조사 지원팀에 고객 기술 문의를 전달하는 표준 양식. 표는 폼으로, 요청내용은 본문에 이미지 포함 자유 작성.",
  "tableHeader": ["구분", "상세내용"],
  "sections": [
    {
      "title": "",
      "fields": [
        {
          "key": "topic",
          "label": "메일 제목",
          "type": "text",
          "placeholder": "예: [{company}] 알림 이름이 같을 때 규칙 활성화/비활성화 개선 요청 (제트플러스)",
          "required": true,
          "subjectOnly": true,
          "wide": true
        },
        {
          "key": "intro",
          "label": "도입 문장",
          "type": "text",
          "placeholder": "예: 제트플러스 지원 중 개선 요청사항이 있어 메일 드립니다.",
          "introLead": true,
          "wide": true
        },
        {
          "key": "issue",
          "label": "이슈",
          "type": "text",
          "bodyLead": true,
          "wide": true,
          "placeholder": "예: 이름이 같은 규칙을 켜면 다른 규칙도 켜진 것처럼 보임"
        }
      ]
    },
    {
      "title": "기본 정보",
      "fields": [
        { "key": "requestDate", "label": "요청일자", "type": "date", "default": "today", "required": true },
        { "key": "customer", "label": "고객사명", "type": "text", "placeholder": "제트플러스 / AB Z+ / 가나스토어", "required": true },
        { "key": "project", "label": "프로젝트명", "type": "text", "placeholder": "서비스SRE (서원) / 한강SRE / 관제개발팀", "wide": true },
        { "key": "serverOs", "label": "수집서버 OS 및 버전", "type": "text", "placeholder": "RHEL 8.10", "wide": true },
        { "key": "serverSpec", "label": "수집서버 스펙", "type": "text", "default": "-" },
        {
          "key": "product",
          "label": "문의 제품",
          "type": "text",
          "placeholder": "예: 이벤트 / 메트릭스 차트 / 서버모니터링 / BMS (직접 입력 또는 선택)",
          "options": ["Job Manager", "서버모니터링", "APM", "NMS 콘솔", "웹 점검", "데이터베이스", "쿠버네티스", "로그 모니터링", "이벤트", "메트릭스 차트", "RUM"],
          "wide": true
        }
      ]
    },
    {
      "title": "제조사 정보",
      "fields": [
        { "key": "contractType", "label": "계약 유형", "type": "select", "options": ["계약", "POC", "유상", "무상"] },
        { "key": "serviceType", "label": "서비스 유형", "type": "select", "options": ["설치형", "SaaS", "설치형, SaaS"] },
        { "key": "serverVersion", "label": "수집서버 버전", "type": "text", "placeholder": "collector-x.y.z", "wide": true },
        { "key": "agentVersion", "label": "에이전트 버전", "type": "text", "placeholder": "job-manager-x.y.z", "wide": true },
        { "key": "logFile", "label": "로그파일", "type": "text", "default": "-" }
      ]
    }
  ],
  "hasBody": true,
  "bodyLabel": "요청내용",
  "bodyPlaceholder": "문의 배경과 구체적 질문을 작성하세요. 화면 캡처 이미지·글머리 기호 사용 가능."
}
